# Disjoint Cloudflare Pages rules. Matching header values combine.
# Versioned assets: immutable; originals: one hour; HTML: revalidate.
# Edge overrides and effective deployment headers require host verification.

/assets/versioned/*
  Cache-Control: public, max-age=31536000, immutable

/media/versioned/*
  Cache-Control: public, max-age=31536000, immutable

/dist/css/app.1cb140d8ba31d5b2f1114537dd04802a.css
  Cache-Control: public, max-age=31536000, immutable

/dist/js/app.3fc0f988d21662902933.js
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=3600, must-revalidate

/images/*
  Cache-Control: public, max-age=3600, must-revalidate

/cars.jpg
  Cache-Control: public, max-age=3600, must-revalidate

/crv.jpg
  Cache-Control: public, max-age=3600, must-revalidate

/face.jpg
